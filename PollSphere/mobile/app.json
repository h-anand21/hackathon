{
  "expo": {
    "name": "PollSphere",
    "slug": "pollsphere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pollsphere",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pollsphere.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PollSphere uses camera to scan QR codes for joining live poll rooms.",
        "NSPhotoLibraryUsageDescription": "PollSphere allows saving QR code cards to photo library for sharing."
      }
    },
    "android": {
      "package": "com.pollsphere.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "updates": {
      "url": "https://u.expo.dev/73b076ba-9e92-4b95-b31d-fcb75d43895d"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "./plugins/withExcludeOldSupportLibs",
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#09090b"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "PollSphere uses camera to scan QR codes for joining live poll rooms."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73b076ba-9e92-4b95-b31d-fcb75d43895d"
      }
    }
  }
}
