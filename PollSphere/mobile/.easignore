# EAS Build Archive Exclusions
# EAS uses .easignore (like .gitignore) relative to the project root

# ===== CRITICAL: node_modules (682 MB) =====
node_modules/
node_modules/**

# ===== Expo cache =====
.expo/
dist/
web-build/

# ===== Build outputs =====
*.apk
*.aab
*.tar.gz
*.tgz
*.zip
android/
ios/

# ===== System & IDE =====
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.claude/

# ===== Metro =====
.metro-health-check*

# ===== Local Env =====
.env.local
.env.development.local
.env.test.local
.env.production.local

# ===== Debug logs =====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
