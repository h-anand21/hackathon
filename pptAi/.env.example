# PostgreSQL database connection string (e.g. from Neon.tech, Supabase, etc.)
DATABASE_URL="postgresql://username:password@host:port/dbname?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="generate_a_secret_key_here" # Use `npx @better-auth/cli secret` to generate
BETTER_AUTH_URL="http://localhost:3000"

# MeshAPI Key (from https://developers.meshapi.ai/)
MESH_API_KEY="your_mesh_api_key"

# ImageKit Configuration (from https://imagekit.io/)
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_BASE_URL="your_imagekit_url_endpoint"

# OAuth Credentials (optional but needed for Google/GitHub Login)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Optional client-facing settings
VITE_APP_TITLE="PPT.ai"
SERVER_URL="http://localhost:3000"
